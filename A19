#include <stdio.h>

// Function declaration (prototype)
int addNumbers(int a, int b);

int main() {
    int result = addNumbers(10, 20); // Function call
    printf("The sum is: %d\n", result);
    return 0;
}

// Function definition
int addNumbers(int a, int b) {
    return a + b; // Returns the result to the caller
}
